{
  "name": "whose-chance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:emu": "firebase emulators:start --only auth,firestore --project demo-hirer",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hirer \"vitest run -c vitest.rules.config.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:rules && npm run build",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "dev:local": "vite --mode emulator"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "diff": "^5.2.2",
    "firebase": "^11.10.0",
    "framer-motion": "^11.18.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/diff": "^5.2.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-tools": "^13.35.1",
    "globals": "^15.15.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  }
}
